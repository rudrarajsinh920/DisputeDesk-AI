# Copy to .env and fill in. Never commit .env.
# PayPal sandbox app (optional: without it, the sandbox view says it is not configured)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: without it, AI drafting is off and the rest works
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite. Lowercase letters, digits, "." and "-" only.
GEMINI_MODEL=
